# mock (default, deterministic, no key) | live (real model)
LLM_MODE=mock
# gemini (Google AI Studio free tier) | openrouter
LLM_PROVIDER=gemini

# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenRouter (alternative): https://openrouter.ai/models?supported_parameters=tools
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

LLM_TIMEOUT_SECONDS=30
# role-scoped API keys: key:role,key:role
API_KEYS=dev-requester-key:requester,dev-operator-key:operator
