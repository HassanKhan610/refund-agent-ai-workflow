# mock (default, deterministic, no key) | live (OpenRouter)
LLM_MODE=mock
OPENROUTER_API_KEY=
# Pick a free model that supports tool calling: https://openrouter.ai/models?supported_parameters=tools
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_SECONDS=30
# role-scoped API keys: key:role,key:role
API_KEYS=dev-requester-key:requester,dev-operator-key:operator
